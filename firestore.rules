rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'a01020581925@gmail.com';
    }

    // 예약: 누구나 새 예약을 접수(create)할 수 있지만,
    // 목록을 읽거나 수정/삭제하는 것은 관리자 본인만 가능합니다.
    match /reservations/{reservationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 알림 토큰: 관리자 본인만 등록/조회 가능 (Cloud Function은 서버 권한으로 항상 접근 가능)
    match /admin_tokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    // 확정된 예약(캘린더용): 관리자 본인만 접근 가능
    match /appointments/{appointmentId} {
      allow read, write: if isAdmin();
    }
  }
}
